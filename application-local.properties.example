# Sao chep file nay thanh application-local.properties (cung thu muc goc du an) va dien gia tri that.
# KHONG commit file application-local.properties len Git.

DB_HOST=localhost
DB_PORT=1433
DB_NAME=utetra
DB_USERNAME=utetra_app
DB_PASSWORD=DOI_MAT_KHAU_CUA_BAN

# Khoa ky JWT: chuoi ngau nhien >= 32 ky tu. Moi may tu dat, khong dung chung voi nguoi khac.
JWT_SECRET=DOI_THANH_CHUOI_NGAU_NHIEN_DAI_IT_NHAT_32_KY_TU

# Cloudinary (Day 5): lay o Cloudinary Console > Dashboard > "API Keys". Moi may tu dien, KHONG gui api-secret cho ai.
# De trong thi web van chay, chi khong upload duoc anh san pham.
cloudinary.cloud-name=
cloudinary.api-key=
cloudinary.api-secret=

# VNPay sandbox (Day 9): lay trong email/tai khoan merchant sandbox. KHONG commit khoa that.
vnpay.tmn-code=MA_WEBSITE_SANDBOX
vnpay.hash-secret=KHOA_BI_MAT_SANDBOX
# Localhost chi nhan Return URL trong trinh duyet. IPN production can URL HTTPS cong khai:
# https://ten-mien-cua-ban/payments/vnpay/ipn
vnpay.return-url=http://localhost:8080/payments/vnpay/return
